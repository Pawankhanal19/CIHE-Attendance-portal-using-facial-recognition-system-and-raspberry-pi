# Raspberry Pi — environment variables
# Copy this file to ~/face_attendance/.env on the Pi
# Generate both keys with: openssl rand -hex 32

# URL of the Node.js web app (replace with your server's IP)
API_URL=http://192.168.1.100:5050

# Shared secret for POSTING attendance to the web app
# Must match PI_API_KEY in the server's .env
API_KEY=replace-with-openssl-rand-hex-32

# Shared secret for RECEIVING control commands from the web app
# Must match PI_CONTROL_KEY in the server's .env
CONTROL_KEY=replace-with-openssl-rand-hex-32

# Unique identifier for this Pi camera
DEVICE_ID=raspberry-pi-door-01
